# The app calls the API on the same origin (/api). In development Vite proxies /api and /uploads
# to this target; in production vercel.json rewrites them to the Render backend.
VITE_PROXY_TARGET=http://localhost:3000

# Public API keys of the hosted websites (/websites/tuaja, /websites/dan). Optional — default to the
# seeded demo keys. Set them if you regenerate a site's key in Websites → Regenerate API key.
VITE_TUAJA_API_KEY=
VITE_DAN_API_KEY=
