<h1 style="margin:0 0 12px 0;font-size:20px;color:#4A4A89;">Welcome to PIF Admin Panel, {{name}}!</h1>
<p style="margin:0 0 16px 0;font-size:14px;line-height:22px;">{{invitedBy}} created an account for you with the <b>{{role}}</b> role.</p>
{{#if sites.length}}
<p style="margin:0 0 6px 0;font-size:13px;color:#8C9097;">Websites you can manage:</p>
<p style="margin:0 0 16px 0;">{{#each sites}}<span style="display:inline-block;background:#F0EEF8;color:#4A4A89;border-radius:999px;padding:4px 10px;font-size:12px;margin:0 6px 6px 0;">{{this}}</span>{{/each}}</p>
{{/if}}
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;background:#F7F8F9;border:1px solid #E9EDF6;border-radius:12px;margin:0 0 20px 0;">
  <tr><td style="padding:16px 18px;font-size:14px;line-height:24px;">
    <b>Email:</b> {{email}}<br>
    <b>Temporary password:</b> <code style="font-size:15px;background:#fff;border:1px solid #E9EDF6;border-radius:6px;padding:2px 8px;color:#552A0E;">{{tempPassword}}</code><br>
    <span style="font-size:12px;color:#8C9097;">Valid until {{expiresAt}}</span>
  </td></tr>
</table>
<p style="margin:0 0 8px 0;font-size:14px;line-height:22px;"><b>How to sign in</b></p>
<ol style="margin:0 0 20px 18px;padding:0;font-size:14px;line-height:22px;">
  <li>Sign in with your email and the temporary password.</li>
  <li>Enter the 6-digit verification code we email you.</li>
  <li>Choose your own password — you will be asked to do this right away.</li>
</ol>
<p style="text-align:center;margin:0 0 24px 0;"><a href="{{loginUrl}}" style="display:inline-block;background:#552A0E;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;border-radius:999px;padding:12px 32px;">Sign in to PIF Admin Panel</a></p>
