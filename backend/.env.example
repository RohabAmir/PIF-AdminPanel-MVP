# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Vercel + Render = 2 in production)
TRUST_PROXY=1

# ── URLs ────────────────────────────────────────────────
DATABASE_URL=postgresql://pif:pif@localhost:5432/pif_admin?schema=public
# Where the admin panel runs (used in email links)
FRONTEND_URL=http://localhost:5173
# Public base URL of this API (used to build absolute media URLs in the public API)
API_PUBLIC_URL=http://localhost:3000
# Comma-separated allow-list for the admin API (credentials enabled)
CORS_ORIGINS=http://localhost:5173

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_OTP_SECRET=change-me-otp-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Concurrent refreshes (two tabs) within this window are not treated as token reuse
REFRESH_REUSE_GRACE_SECONDS=10
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
# lax locally; with the Vercel /api proxy the browser sees one origin, so lax also works in production
COOKIE_SAMESITE=lax
# Max auth requests (login / OTP / forgot) per minute per IP and per email
AUTH_RATE_LIMIT=10

# ── Email (Mailpit locally: SMTP localhost:1025, inbox http://localhost:8025) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PIF Admin Panel <no-reply@pifdemo.com>"

# ── Demo mode (public demo only) ───────────────────────
DEMO_MODE=false
DEMO_PASSWORD=Demo@12345

# ── Media ───────────────────────────────────────────────
# local | cloudinary | url  (url = uploads disabled, image URL fields only)
MEDIA_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
